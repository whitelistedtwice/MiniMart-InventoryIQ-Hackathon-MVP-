# Frontend public configuration.
# Only public values belong here. Never put backend secrets (Gemini key,
# Google service-account) in frontend environment variables.

# Base URL of the InventoryIQ FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production example:
# NEXT_PUBLIC_API_BASE_URL=https://inventoryiq-api.onrender.com
