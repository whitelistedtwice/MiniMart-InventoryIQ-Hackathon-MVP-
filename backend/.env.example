# Copy to .env and fill in real values. Never commit .env.

# Google Sheets data source (read-only). Provide ONE of:
# - GOOGLE_SERVICE_ACCOUNT_JSON: full service-account JSON as a string (preferred on PaaS)
# - GOOGLE_SERVICE_ACCOUNT_FILE: path to a service-account JSON file (local dev)
GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Optional demo mode: load backend/demo/cambodian_mini_mart.json instead of Sheets.
# Use this for hackathon demos when real Google credentials are not available.
# DEMO_MODE=true

# Business profile (single business, env configuration — no database).
BUSINESS_NAME=Your business name
BUSINESS_TYPE=Mini-mart

# ISO 4217 currency code for every money value, e.g. USD or KHR.
# Leave unset to show plain amounts without a currency symbol.
BUSINESS_CURRENCY=USD

# Optional Gemini explanation layer. Leave unset to disable AI explanations.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Comma-separated frontend origins allowed by CORS.
# Local dev default; set to your deployed frontend origin in production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Connection probe tuning (seconds).
SHEETS_PROBE_TIMEOUT_SECONDS=3
SHEETS_CONNECTION_CACHE_TTL_SECONDS=60
